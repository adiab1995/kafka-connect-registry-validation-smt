{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "Order",
  "type": "object",
  "properties": {
    "orderId": { "type": "string" },
    "productCode": { "type": "string", "pattern": "^[0-9]{2}$" },
    "comment": { "type": ["null", "string"] },
    "items": {
      "type": ["null", "array"],
      "items": { "$ref": "#/$defs/Item" }
    }
  },
  "required": ["orderId", "productCode"],
  "$defs": {
    "Item": {
      "type": "object",
      "properties": {
        "sku": { "type": "string" },
        "amount": { "type": "string" }
      },
      "required": ["sku"]
    }
  }
}
